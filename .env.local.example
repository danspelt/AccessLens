# AccessLens — local environment template
# Copy to .env.local and fill in values:
#   cp .env.local.example .env.local
#
# Scripts (seeds/indexes) do not auto-load this file. Either export vars first or:
#   node --env-file=.env.local --import tsx scripts/seedCities.ts

# ---------------------------------------------------------------------------
# MongoDB
# ---------------------------------------------------------------------------
# Docker Compose (docker-compose.mongo.dev.yml): root user is in the admin auth DB.
# Wrong authSource is the usual cause of "Authentication failed".
MONGODB_URI=mongodb://root:devpassword@localhost:27017/accesslens?authSource=admin
MONGODB_DB=accesslens

# ---------------------------------------------------------------------------
# NextAuth (Auth.js)
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=replace-with-a-long-random-secret
# Optional legacy Auth.js alias. Use only when AUTH_SECRET is not set.
# NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Optional Google sign-in (leave blank for email + password only)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Business access sessions (iron-session)
# Used by /update-accessibility/[code] QR claim flow.
# Must be at least 32 characters. Falls back to SESSION_SECRET if unset.
# ---------------------------------------------------------------------------
BUSINESS_SESSION_SECRET=replace-with-another-long-random-secret-32+
# Optional legacy alias used as fallback by business sessions:
# SESSION_SECRET=replace-with-a-long-random-secret-min-32-chars

# ---------------------------------------------------------------------------
# Email (Resend) — optional for magic links and followed-place update mail; outbound mail is skipped if unset
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@localhost

# ---------------------------------------------------------------------------
# App URL
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Geocoding (optional)
# ---------------------------------------------------------------------------
# Optional Nominatim contact identity used by the server-side geocoder.
# Replace the example address before production traffic.
# NOMINATIM_USER_AGENT=AccessLens (contact: you@example.com)

# Optional end-to-end test target. When omitted, Playwright builds and starts
# the application locally at http://127.0.0.1:3000.
# PLAYWRIGHT_BASE_URL=https://staging.example.org

# Production also requires the public HTTPS URL used by Auth.js callbacks.
# AUTH_URL=https://accesslens.example.org
# Set AUTH_TRUST_HOST=false only when AUTH_URL is fixed and your proxy setup requires it.
# AUTH_TRUST_HOST=true

# Production upload note: current uploads use /app/public/uploads. Mount that path
# to persistent storage or replace the local adapter before launch.
